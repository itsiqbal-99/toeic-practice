{
  "name": "toeic-practice",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @toeic/web",
    "dev:api": "npm run dev -w @toeic/api",
    "build:packages": "tsc -b packages/shared packages/content",
    "build": "npm run build:packages && npm run build -w @toeic/api && npm run build -w @toeic/web",
    "typecheck": "npm run build:packages && tsc -p apps/api --noEmit && tsc -p apps/web --noEmit && tsc -p tests --noEmit",
    "lint": "eslint apps packages scripts tests",
    "test": "npm run build:packages && vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "db:migrate": "npm run db:migrate -w @toeic/api",
    "db:seed": "npm run db:seed -w @toeic/api",
    "content:validate": "tsx scripts/validate-content.ts",
    "generate:audio": "tsx scripts/generate-audio.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^26.1.0",
    "node-edge-tts": "^1.2.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "^2.5.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "^5.4.1"
    }
  }
}
